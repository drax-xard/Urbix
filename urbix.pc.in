prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: urbix
Description: deterministic infinite procedural city engine
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lurbix
Libs.private: -ldl -lm
Cflags: -I${includedir}
