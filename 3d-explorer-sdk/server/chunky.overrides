# server/chunky.overrides — chunky mid-rise proportion template.
#
# Demo override file for `serve --config` (KEY = VALUE lines, `#` comments).
# These values were A/B-tested here and promoted to the engine defaults in
# 0.17.0, so applying this file now reproduces the default city — edit it as
# a starting template for further experiments:
#   ./server/serve --seed 445566 --web server/www --config server/chunky.overrides
# CLI flags (--seed, --chunk-size, --draw-distance) override file values.
#
# Aim: heights near 4-6x the typical lot width (lots run ~3-5 cells = 12-20 m
# at the 1 cell = 4 m canon), so towers read as broad masses, not spikes.
# Bands stay overlapping so fuzzy district borders still blend gradually.

# Downtown: 24-110 caps the crown at ~27 storeys.
downtown.height_min = 24.0
downtown.height_max = 110.0

# Commercial: 10-45 keeps mid-rise boulevards.
commercial.height_min = 10.0
commercial.height_max = 45.0

# Industrial sheds: lower lid, same yards.
industrial.height_max = 20.0

# Residential: houses read better a touch lower.
residential.height_max = 14.0
