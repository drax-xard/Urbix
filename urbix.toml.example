# Example Urbix configuration (TOML) — modular customization (Milestone 8)
#
# Copy to `urbix.toml` and edit, then run:
#   cargo run -- --config urbix.toml --seed 445566 --cx 0 --cy 0 --format bin
# CLI flags (`--seed`, `--chunk-size`, etc.) override file values.
#
# Interior blueprint tables (Milestone 9): the per-zone `interior_blueprints`
# array is optional — when omitted, `WorldConfig::default()` tables are used
# (see `layout.rs:blueprint_defaults`). To customize one, provide the full
# 8-room fixed array for that zone, e.g.:
#
#   [[interior_blueprints]]
#   margin = 1
#   core_size = 2
#   room_count = 4
#   [[interior_blueprints.rooms]]
#   kind = 20; weight = 4.0; min_w = 3; max_w = 5; min_d = 3; max_d = 5
#   [[interior_blueprints.rooms]]
#   kind = 21; weight = 3.0; min_w = 2; max_w = 3; min_d = 2; max_d = 3
#   ... (8 rooms total)

seed = 445566
chunk_size = 32
draw_distance = 8
voronoi_site_count = 32
voronoi_span = 10000.0
shepard_power = 4.0
shepard_epsilon = 1e-8
zone_weights = [0.25, 0.30, 0.20, 0.15, 0.10]
zone_hues = [[100, 150, 220], [96, 180, 90], [235, 160, 70], [150, 130, 115], [140, 205, 120]]
interior_width_range = [6, 14]
interior_height_range = [6, 14]
interior_floor_height = 4.0
interior_max_floors = 64
# interior_blueprints omitted → defaults

# Scale canon (Milestone 11): 1 cell = 4 m. Block sizes are in cells;
# multiply by 4 for metres. `arterial_every` K makes every K-th street a
# 2-cell arterial avenue (0 disables arterials).

[[zones]]
height_min = 24.0
height_max = 110.0
density = 0.95
block_size = 11
palette_count = 6
arterial_every = 4
slenderness_max = 5

[[zones]]
height_min = 4.0
height_max = 14.0
density = 0.80
block_size = 10
palette_count = 5
arterial_every = 5
slenderness_max = 5

[[zones]]
height_min = 10.0
height_max = 45.0
density = 0.90
block_size = 9
palette_count = 7
arterial_every = 4
slenderness_max = 5

[[zones]]
height_min = 6.0
height_max = 20.0
density = 0.70
block_size = 14
palette_count = 4
arterial_every = 6
slenderness_max = 5

[[zones]]
height_min = 0.0
height_max = 2.0
density = 0.10
block_size = 18
palette_count = 3
arterial_every = 0
slenderness_max = 5
